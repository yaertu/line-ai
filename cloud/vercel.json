{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [{"path":"/api/engine-maintenance","schedule":"0 9 * * *"}],
  "rewrites": [
    {"source":"/api/v1/capabilities","destination":"/api/v1/engine?route=capabilities"},
    {"source":"/api/v1/generate","destination":"/api/v1/engine?route=generate"},
    {"source":"/api/v1/images/generations","destination":"/api/v1/engine?route=images"},
    {"source":"/api/v1/images/:id","destination":"/api/v1/engine?route=image&id=:id"},
    {"source":"/api/v1/assets/:id","destination":"/api/v1/engine?route=asset&id=:id"},
    {"source":"/api/v1/requests/:id","destination":"/api/v1/engine?route=request&id=:id"},
    {"source":"/api/v1/feedback","destination":"/api/v1/engine?route=feedback"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'; img-src 'self' data:; connect-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
      ]
    }
  ]
}
