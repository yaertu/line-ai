{
  "name": "lineai-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "verify:database": "node --env-file=.env.local scripts/verify-database.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vercel/node": "10.0.0",
    "postgres": "3.4.9",
    "typescript": "7.0.2"
  }
}
